# Fluxa server configuration — copy to .env and edit.
# The server reads these from the environment; nothing here is required to run locally.

# HTTP/WebSocket port and bind address
PORT=8787
HOST=0.0.0.0

# Public base URL used to build QR / pairing links (no trailing slash).
# Leave empty for local development.
FLUXA_PUBLIC_URL=

# Comma-separated WebSocket origin allow-list. Empty means "allow any origin"
# (fine for local development, not for a public deployment).
FLUXA_ALLOWED_ORIGINS=

# Set to 1 only when a trusted reverse proxy supplies X-Forwarded-For.
FLUXA_TRUST_PROXY=0

# ICE servers handed to browsers. Default empty = host candidates only,
# which is enough for same-machine and same-LAN transfers.
#
# STUN only:
# FLUXA_ICE_SERVERS='[{"urls":"stun:stun.example.com:3478"}]'
#
# STUN + TURN (replace the credentials; prefer short-lived TURN credentials):
# FLUXA_ICE_SERVERS='[
#   {"urls":"stun:stun.example.com:3478"},
#   {"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],
#    "username":"fluxa",
#    "credential":"REPLACE_ME"}
# ]'
FLUXA_ICE_SERVERS=[]
