# Fluxa server example — put real values in an UNTRACKED deployment environment.
PORT=8787
HOST=0.0.0.0

# On public deployments terminate TLS at a trusted reverse proxy.
# FLUXA_PUBLIC_URL=https://fluxa.example.com
# FLUXA_ALLOWED_ORIGINS=https://fluxa.example.com,https://localhost,http://localhost,capacitor://localhost
# FLUXA_TRUST_PROXY=1   # only behind a trusted proxy that sets X-Forwarded-For

# STUN only (host candidates work locally without it). No static TURN credentials:
FLUXA_ICE_SERVERS=[]
# FLUXA_ICE_SERVERS='[{"urls":"stun:relay.example.com:3478"}]'

# Optional coturn REST relay. All three variables must be set together. Generate
# two DIFFERENT values with `openssl rand -hex 32`. Never use a CircleCI API
# token, GitHub PAT or static ICE password for either key. Users enter ONLY the
# enrolment key in Settings; the REST secret stays on the server and coturn.
# FLUXA_TURN_URLS='["turn:relay.example.com:3478?transport=udp","turns:relay.example.com:5349?transport=tcp"]'
# FLUXA_TURN_SECRET=REPLACE_WITH_OWN_RANDOM_REST_SECRET
# FLUXA_TURN_ACCESS_KEY=REPLACE_WITH_SEPARATE_RANDOM_ENROLMENT_KEY
# FLUXA_TURN_TTL_SECONDS=43200
